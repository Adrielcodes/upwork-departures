# Upwork API app — https://www.upwork.com/developer/keys/apply
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=https://your-domain.vercel.app/api/callback
# Optional: only needed if your account belongs to several organizations
UPWORK_TENANT_ID=

# Long random strings (e.g. `openssl rand -hex 32`)
ADMIN_KEY=        # lets you visit /api/connect?key=… and /api/sync?key=…
CRON_SECRET=      # Vercel Cron sends this automatically
FLIGHT_SALT=      # scrambles proposal ids into public flight numbers — never change it once live

# Set automatically when a private Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=

# Time zone used for the board's clock and departure times
NEXT_PUBLIC_BOARD_TZ=America/New_York
